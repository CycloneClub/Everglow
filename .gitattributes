# Normalize text files to LF by default.
* text=auto eol=lf

# Keep common source and text asset formats explicitly on LF.
*.cs text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.fx text eol=lf

# Use CRLF for Visual Studio solution and project files.
*.sln text eol=crlf
*.csproj text eol=crlf

# Treat generated workflow lock files as generated and keep ours on merge.
.github/workflows/*.lock.yml linguist-generated=true merge=ours
