GunOfAvarice: {
	DisplayName: Gun Of Avarice
	Tooltip:
		'''
		Automatically reloads after 14 shots, preventing attacks for 1.5 seconds
		Reloading has an 80% chance to raise the level by 1, up to level 10
		Shot damage is multiplied by (1 + 0.18 × current level)
		A failed reload resets the level to 1 and causes an explosion that hurts you
		Explosion base damage is 1.5 times the weapon base damage with the previous level bonus
		Right-click with a partially empty magazine to reload in 0.5 seconds and reset to level 1
		'''
}

