CrowdConfig: {
	DisplayName: Town Crowds
	Enabled: {
		Label: Town travelers
		Tooltip: "Adds travelers who walk, linger, and converse in Yggdrasil Town. Only active in single-player Yggdrasil. Disabling removes existing travelers."
	}
	Density: {
		Label: Crowd density
		Tooltip: "Adjusts the number of travelers on streets and trains. Higher density may increase performance cost. Lower density takes effect gradually as travelers leave."
	}
}

CrowdDensity: {
	Tooltip: Controls how busy the town feels.
	Sparse.Label: Sparse
	Standard.Label: Standard
	Busy.Label: Busy
}

MirrorReflectionConfig: {
	DisplayName: Mirror Reflections (Client)
	Enabled: {
		Label: Enable reflections
		Tooltip: "Skip reflection capture and drawing for reflective vanilla walls and the Advanced Mirror demo when disabled. Wall surfaces remain visible. Client only; requires High visual quality and Color/White lighting."
	}
	Quality: {
		Label: Reflection quality
		Tooltip: "Controls the smoothness of blurred reflections. Low reduces filtering cost, Medium balances quality and cost, and High keeps full filtering quality. Does not change wall offsets, flipping, colors, or reflection strength."
	}
}

MirrorReflectionQuality: {
	Tooltip: Controls filtering quality for blurred reflections.
	Low.Label: Low
	Medium.Label: Medium
	High.Label: High
}

