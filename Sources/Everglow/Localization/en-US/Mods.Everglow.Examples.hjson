ExampleDialogueQuest: {
	Dialogue: {
		Intro: "This conversation is defined directly in the quest objective chain."
		Request: "Please bring ten Dirt Blocks, then press Deliver when ready."
		Accept: "Accept"
		Accepted: "Thank you. Open Quest again when you are ready to deliver."
		Deliver: "Deliver"
		Missing: "You need more Dirt Blocks. Confirm again when you are ready."
		Thanks: "Received! Here is a Silver Coin for your help."
		Goodbye: "The objective has completed, but this reply stays until you finish reading."
	}
}

