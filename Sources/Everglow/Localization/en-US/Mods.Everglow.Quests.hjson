Anna: "Anna"

Howard: "Howard"

SmuggledAleQuest: {
	Dialogue: {
		Objective0: "Hey, you. Since you're asking, have you got any [i/s5:Ale]? Bring me a little, just a little. Make sure the higher-ups don't see."
		Objective1Request: "Hey, you. Since you're asking, have you got any [i/s5:Ale]? Bring me a little, just a little. Make sure the higher-ups don't see."
		Objective1Success: "Shh, keep it down. Don't let the higher-ups see. Thanks! Take these coins and gel for your trouble."
	}
	DisplayName: "Smuggled Ale"
	Description: "Anna has a small request she would rather keep from her superiors."
	Hint: "Reach Yggdrasil"
	Objectives: [
		{
			Description: "Anna seems to have a small favor to ask. Go and have a word with her."
		}
		{
			Description: "Anna would like a quiet drink. Bring her some ale, and keep it out of sight of her superiors."
		}
	]
}

SheWorriesAboutYouQuest: {
	Dialogue: {
		Objective0: "Have you heard of the monster they call the Blood Moon Cultist? He's real trouble. If you run into him, be careful."
		Objective2: "I didn't expect you to deal with that monster yourself. You've solved a problem for us. Dinner is on me tonight."
	}
	DisplayName: "She Worries About You"
	Description: "Rumors of the Blood Moon Cultist have Anna worried."
	Hint: "Complete Smuggled Ale"
	Objectives: [
		{
			Description: "Anna has heard some troubling news and seems to have a warning for you. Go and speak to her."
		}
		{
			Description: "After hearing Anna's warning, kill a Blood Moon Cultist and give her one less reason to worry."
		}
		{
			Description: "You have killed a Blood Moon Cultist. Return to Anna and put her mind at ease."
		}
	]
}

SlimeDoctorQuest: {
	Dialogue: {
		Objective0: "This little one got hurt, but I can't leave my post. Could you get me some gel? It might help."
	}
	DisplayName: "Slime Doctor"
	Description: "A little creature is hurt, and Anna needs help looking after it."
	Hint: "Stop the Drunken Miners' Parade"
	Objectives: [
		{
			Description: "Anna seems to be caring for an injured little creature. See if she needs any help."
		}
		{
			Description: "Anna cannot leave her post to care for the injured little creature. Bring her some gel; it might help."
			ObjectiveText: "Collect gel for Anna."
		}
	]
}

DefendTownQuest: {
	Dialogue: {
		Objective0: "What's troubling me? I heard you recently defeated the Squamous Shell. Good. That proves you can handle yourself. Some troublemakers have been stirring things up in town, and the residents are complaining. Go teach them a lesson."
		Objective2: "Good work. Those drunken miners have finally settled down. But a gang of thieves is still causing trouble in town. I'm afraid we'll need your help again."
		Objective4: "I heard you dealt with the thieves. Well done. But the peace didn't last: that heiress and the assassin have stirred up more trouble. Go see what you can do."
		Objective6: "That trouble has finally settled down. But now someone wants to perform a sacrifice right in the streets. We can't let that happen. Stop them!"
		Objective8: "You stopped that sacrifice just in time and kept the townsfolk safe. On behalf of everyone in Yggdrasil Town, thank you."
	}
	Hint: "Defeat the Squamous Shell"
	DisplayName: "Defend Yggdrasil Town"
	Description: "Repeated disturbances trouble Yggdrasil Town. Howard needs help keeping the peace."
	Objectives: [
		{
			Description: "Howard seems troubled by the disturbances in town. Go and ask him about them."
		}
		{
			Description: "The drunken miners are disturbing the peace with their parade. Help Howard bring the trouble to an end."
			ObjectiveText: "Head to Yggdrasil Town, wait for nightfall, and repel the Drunken Miners' Parade."
		}
		{
			Description: "The drunken miners have been dealt with for now. Report back to Howard."
		}
		{
			Description: "Thieves are causing trouble in town. Stop them from running rampant."
			ObjectiveText: "Repel the rampant thieves."
		}
		{
			Description: "The thieves have been dealt with. Return to Howard and ask how the town is faring."
		}
		{
			Description: "Trouble involving the Heiress and the Assassin has disturbed the town again. Help Howard restore order."
			ObjectiveText: "Repel the Heiress and the Assassin."
		}
		{
			Description: "The trouble with the Heiress and the Assassin has settled for now. Report back to Howard."
		}
		{
			Description: "Someone is attempting a sacrifice in the streets. Put a stop to it before it is too late."
			ObjectiveText: "Stop the street sacrifice."
		}
		{
			Description: "The street sacrifice has been stopped. Let Howard know the town is safe for now."
		}
	]
}

Rolle: "Rolle"

Betty: "Betty"

Schorl: "Schorl"

Georg: "Georg"

IngredientSupplyOneQuest: {
	Dialogue: {
		Objective0: "Ah, you're new here. Since you asked, business has been so good these past few days that we haven't had time to restock. Bring me some [i/s5:Everglow/GrassCarp] and dinner is on me."
		Objective1Request: "Ah, you're new here. Since you asked, business has been so good these past few days that we haven't had time to restock. Bring me some [i/s5:Everglow/GrassCarp] and dinner is on me."
		Objective1Success: "These fish are nice and plump. As promised, dinner is on me."
	}
	DisplayName: "Restocking Ingredients I"
	Description: "Business has been so good that Rolle has run short of fish."
	Hint: "Reach Yggdrasil"
	Objectives: [
		{
			Description: "Ask Rolle at the restaurant whether he needs any help."
		}
		{
			Description: "Bring Rolle five grass carp to restock the restaurant."
		}
	]
}

SelfRelianceQuest: {
	Dialogue: {
		Objective0: "Still looking for work at this hour? I don't want to see you too hungry to lift your sword. You seem willing to learn, so I'll teach you to make grass carp marinated in lampfruit juice. Then you can feed yourself."
		Objective2: "Got the [i/s12:Everglow/LampFruit]? Preparing your own ingredients is the first step. They'll come in handy for marinated grass carp."
	}
	DisplayName: "Self-Reliance"
	Description: "Rolle wants to teach you how to prepare a filling meal."
	Hint: "Defeat King Jelly Ball or the Squamous Shell"
	Objectives: [
		{
			Description: "Rolle has some cooking advice to share."
		}
		{
			Description: "Bring twelve lampfruits. Rolle only needs to see them, and they stay yours."
		}
		{
			Description: "You have enough lampfruits. Return to Rolle."
		}
	]
}

IngredientSupplyTwoQuest: {
	Dialogue: {
		Objective0: "I heard you've encountered Mossy Thorn Turtles. Get me one. Perhaps we can come up with a new dish."
		Objective2: "Very fresh! You have a good eye. That wasn't so hard, was it? I have to go. The ideas are pouring in!"
	}
	DisplayName: "Restocking Ingredients II"
	Description: "Rolle hopes the Mossy Thorn Turtle will inspire a new dish."
	Hint: "Enter Kelp Curtain"
	Objectives: [
		{
			Description: "Ask Rolle about his idea for a new ingredient."
		}
		{
			Description: "Defeat one Mossy Thorn Turtle in Kelp Curtain."
		}
		{
			Description: "You defeated the turtle. Report back to Rolle."
		}
	]
}

SprainedBackQuest: {
	Dialogue: {
		Objective0: "The boss hurt his back while trying out a new dish. You two seem to be old friends now. Could you bring me the ingredients for his medicinal oil so he can recover sooner?"
		Objective3: "That's everything. Thank you! I hope he recovers soon. We'll have to make sure he rests."
	}
	DisplayName: "An Aching Back"
	Description: "Rolle hurt his back while experimenting with a new dish. Betty needs ingredients for his medicine."
	Hint: "Complete Self-Reliance"
	Objectives: [
		{
			Description: "Ask Betty what is troubling her."
		}
		{
			Description: "Give Betty the Unstable Pollen for the medicinal oil."
		}
		{
			Description: "Give Betty the Caterpillar Juice for the medicinal oil."
		}
		{
			Description: "Both ingredients have been delivered. Check back with Betty."
		}
	]
}

TroublesomeGuestsQuest: {
	Dialogue: {
		Objective0: "You know those pirates? They haven't paid their bills for three months. Collect the debt for me and you'll get a share."
		Objective2: "Thank you. I hope that works. The fewer troublesome customers, the better."
	}
	DisplayName: "Troublesome Guests"
	Description: "Some pirates have left their restaurant bills unpaid. Betty wants someone to deal with them."
	Hint: "Betty mentions the pirates' debts"
	Objectives: [
		{
			Description: "Find out what is troubling Betty."
		}
		{
			Description: "Find the pirates and make them settle their bills."
			ObjectiveText: "Deal with the pirates who owe the restaurant money."
		}
		{
			Description: "Tell Betty the unpaid bills have been dealt with."
		}
	]
}

TeahouseTalesOneQuest: {
	Dialogue: {
		Objective0: "You're an adventurer, aren't you? I've heard of a monster that looks almost human. Would you investigate this ownerless flesh puppet for me, then take care of it?"
		Objective2: "What an interesting story! Well done. How about a little pat of my tail as your reward?"
	}
	DisplayName: "Teahouse Tales I"
	Description: "Schorl is curious about rumors of an ownerless flesh puppet."
	Hint: "Reach Yggdrasil"
	Objectives: [
		{
			Description: "Schorl has heard a strange rumor."
		}
		{
			Description: "Investigate the humanlike monster and deal with it."
			ObjectiveText: "Find and defeat the ownerless flesh puppet."
		}
		{
			Description: "Bring the story back to Schorl at the teahouse."
		}
	]
}

TeahouseTalesTwoQuest: {
	Dialogue: {
		Objective0: "Do you remember that monster? I'm sure you noticed the marks on its body. Investigate the second layer. A cult's creation is hidden there, and it may hold the answers you seek."
		Objective2: "It's been a long time since I've heard such good news. Shall we celebrate tonight?"
	}
	DisplayName: "Teahouse Tales II"
	Description: "The marks on the monster seem connected to a cult in Kelp Curtain."
	Hint: "Enter Kelp Curtain"
	Objectives: [
		{
			Description: "Visit Schorl to hear her latest lead."
		}
		{
			Description: "Follow the marks on the monster to find traces of the cult."
			ObjectiveText: "Investigate the cult's creation in Kelp Curtain."
		}
		{
			Description: "Return to the teahouse with your findings."
		}
	]
}

ProstheticMaintenanceQuest: {
	Dialogue: {
		Objective1: "You seem to have something I need. My prosthetic limb needs maintenance, but I'm short of Cyan Vine Ore. Could you bring me some? There will be a reward."
		Objective3: "Well done! I knew you could help me."
	}
	DisplayName: "Prosthetic Maintenance"
	Description: "Georg needs materials to maintain his prosthetic limb."
	Hint: "Bring Georg Cyan Vine Ore or Bars, or wear Cyan Vine armor"
	Objectives: [
		{
			ObjectiveText: "Bring Georg Cyan Vine Ore or Bars, or wear Cyan Vine armor."
		}
		{
			Description: "Georg noticed your Cyan Vine materials. Ask what he needs."
		}
		{
			Description: "Find Cyan Vine Ore to help Georg maintain his prosthetic limb."
			ObjectiveText: "Prepare Cyan Vine Ore for Georg."
		}
		{
			Description: "Check on Georg's prosthetic maintenance."
		}
	]
}

ChangingTheInnQuest: {
	Dialogue: {
		Objective0: "To be honest, many guests say the inn feels too stern. I'd like to brighten it up with some plants, but they only grow in Kelp Curtain. You're always helpful. Could you bring me some?"
		Objective2: "Thank you so much. I'll put these plants to good use."
	}
	DisplayName: "Changing the Inn I"
	Description: "Georg wants plants from Kelp Curtain to make his inn more welcoming."
	Hint: "Enter Kelp Curtain"
	Objectives: [
		{
			Description: "Ask Georg about his plans for the inn."
		}
		{
			Description: "Bring Georg plants to decorate his inn."
			ObjectiveText: "Find Kelp Curtain plants for the inn."
		}
		{
			Description: "Return to Georg to discuss his decorating plans."
		}
	]
}

LostMinerQuest: {
	DisplayName: "The Lost Miner"
	Description: "Herm is stranded far from his fellow miners and needs you to take word back to the guild."
	Hint: "Meet Herm in the shallow Tangled Submine"
	Objectives: [
		{
			Description: "Hear Herm's request and accept his commuter card."
		}
		{
			Description: "Deliver the commuter card to the climbing guild's front desk."
		}
		{
			Description: "You delivered the message to the climbing guild. Herm is still in the mine."
			ObjectiveText: "Find Herm in the deep Tangled Submine."
		}
		{
			Description: "Say farewell to Herm and take the lamp that stayed with him."
		}
		{
			Description: "You delivered the message to the climbing guild, but Herm did not return."
			ObjectiveText: "Find Herm's remains in the deep Tangled Submine."
		}
		{
			Description: "Pick up the extinguished lamp beside Herm."
		}
		{
			Description: "Herm will remain in the mine. Return to the guild and report his fate."
		}
	]
	Dialogue: {
		Intro0: "Ah, a new face."
		Intro1: "You can call me Herm. As you can see, I seem to have lost my way."
		Intro2: "I'm running low on supplies. Could you take word of me back to the guild?"
		Intro3: "Take my [i:Everglow/HermCommuterCard] and follow the tunnels back to town. Give it to the lady at the guild's front desk. My fellow miners will come find me."
		Intro4: "Worried about me? This lamp will keep me company. Wherever I go, it stays with me."
		Waiting: "{$Mods.Everglow.NPCs.TownNPCs.Herm.Waiting}"
		Farewell0: "Ahahaha, it's you."
		Farewell1: "As you can see, Balder has been right here beside me all along."
		Farewell2: "Through its light, I can almost see the furnace glowing..."
		Farewell3: "My friend..."
		Corpse: "Herm is no longer breathing. A shattered stalactite pins his leg. An extinguished mining lamp lies quietly beside him."
		Silence: "{$Mods.Everglow.NPCs.TownNPCs.Herm.Silence}"
		TakeLamp: "Take"
		DeliverCard: "Deliver"
		CounterCard: "Is that Herm's [i:Everglow/HermCommuterCard]? Please tell me where he is."
		MissingCard: "Please bring Herm's [i:Everglow/HermCommuterCard]."
		CounterSearch: "Thank you for bringing word. Please search the deep Tangled Submine for Herm. I hope there's still time."
		Report: "Report"
		Report0: "Herm..."
		Report1: "He was a devoted worker and a kind friend."
		CounterThanks: "Thank you for bringing word of Herm. Please look after Balder for him."
	}
}

