ThermoprobeStaff: {
	DisplayName: Thermoprobe Staff
	Tooltip:
		'''
		Summons a floating unit that fires at enemies
		Each unit carries three shots and disappears when empty
		You can have up to twice your maximum number of minions in units
		'''
}

