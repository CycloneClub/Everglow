DevilHeartGyroscope: {
	DisplayName: Devil Heart Gyroscope
	Tooltip:
		'''
		Summons a gyroscope that stores the damage it deals
		After it stores 120 damage, whip it to release a healing heart and reset the charge
		Right-click to toggle the gyroscope power display
		'''
}

