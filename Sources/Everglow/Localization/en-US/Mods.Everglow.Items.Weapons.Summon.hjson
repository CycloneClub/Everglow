	DisplayName: Evil Chrysalis
	Tooltip: ""
}

EvilMusicRemnant: {
	DisplayName: Evil Score Remains
	Tooltip: "'A score left behind by ancient European mages; channel mana into it, and it resounds without an instrument'"
}

GreenVineWhip: {
	DisplayName: Green Vine Whip
	Tooltip:
		'''
		25% chance to inflict Poisoned for 5 seconds
		Hitting an enemy grants Moss Cover for 5 seconds, increasing defense by 5 and granting immunity to Corrosion
		'''
}

