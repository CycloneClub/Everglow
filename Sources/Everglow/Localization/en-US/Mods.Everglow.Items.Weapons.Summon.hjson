RedAlgaeMagicWhip: {
	DisplayName: Crimson Moon Algae Whip
	Tooltip:
		'''
		Inflicts Red Algae Toxin for 15 seconds
		Toxin builds up over time and detonates on the next hit; it deals no damage if it expires
		'''
}

RedAlgaeMinionGyroscope: {
	DisplayName: Crimson Moon Algae Gyroscope
	Tooltip:
		'''
		Summons a gyroscope that releases a toxin ring when struck by a whip
		Inflicts Red Algae Toxin for 15 seconds
		Toxin builds up over time and detonates on the next hit; it deals no damage if it expires
		'''
}

RedAlgaeMinionStaff: {
	DisplayName: Crimson Moon Algae Summon Staff
	Tooltip:
		'''
		Summons an algae spirit that fires 6 spores, then rushes toward an enemy and explodes
		Inflicts Red Algae Toxin for 15 seconds
		Toxin builds up over time and detonates on the next hit; it deals no damage if it expires
		'''
}

RestrictionDeviceRE01: {
