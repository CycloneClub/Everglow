WoodlandWraithStaff: {
	DisplayName: Woodland Wraith Staff
	Tooltip:
		'''
		Summons a woodland wraith that charges for 240% damage or fires bloodstreams for 100% damage
		Right-click to spend 20 mana and create a spore zone lasting 15 seconds
		Enemies inside take 70% more damage from the wraith's bloodstreams
		Stand still out of combat for 2 seconds to let the wraith grow healing mycelium
		Standing on its mycelium grants 5 life regeneration per second, doubled inside your spore zone
		'''
}

