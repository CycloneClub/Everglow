{
	"Anna": "安娜",
	"Howard": "霍华德",
	"SmuggledAleQuest": {
		"Name": "私酒",
		"Description": "安娜有一桩不想让上司知道的小委托。",
		"Hint": "进入天穹树后解锁。",
		"Objectives": [
			{
				"Description": "安娜似乎有点小事想请你帮忙，去和她聊聊吧。",
				"NPCText": "喂，那边的，既然你都问了，你身上有麦芽酒吗？帮我搞一点来，一点就好，小心别被上头看见。"
			},
			{
				"Description": "安娜想偷偷喝上一点麦芽酒，帮她带些来，记得避开她的上司。",
				"StartText": "喂，那边的，既然你都问了，你身上有麦芽酒吗？帮我搞一点来，一点就好，小心别被上头看见。",
				"EndText": "嘘，小声点，别让上头看见。谢啦，这些钱和凝胶你拿着，就当是跑腿的谢礼。"
			}
		]
	},
	"SheWorriesAboutYouQuest": {
		"Name": "她担心你",
		"Description": "血月教徒的传闻让安娜有些担心。",
		"Hint": "完成「私酒」后解锁。",
		"Objectives": [
			{
				"Description": "安娜听说了一个令人不安的消息，似乎想提醒你些什么，去找她聊聊吧。",
				"NPCText": "你最近听说过被称为血月教徒的怪物吗？他可真是个麻烦，如果遇到了，要小心。"
			},
			{
				"Description": "听过安娜的提醒后，去击杀一个血月教徒，让她不再为你担心。"
			},
			{
				"Description": "你击杀了血月教徒，回去告诉安娜，让她放心吧。",
				"NPCText": "没想到你能直接解决那个怪物，也算是帮了我们解决了一项问题，这样吧，晚上我请你一顿。"
			}
		]
	},
	"SlimeDoctorQuest": {
		"Name": "史莱姆医生",
		"Description": "一个小家伙受了伤，安娜需要帮手照料它。",
		"Hint": "平息醉酒矿工游行后解锁。",
		"Objectives": [
			{
				"Description": "安娜似乎正在照料一个受伤的小家伙，去看看她是否需要帮助。",
				"NPCText": "这孩子之前受伤了，但是我抽不开身，能麻烦你帮我搞些凝胶来吗？凝胶应该会有帮助。"
			},
			{
				"Description": "安娜抽不开身照料受伤的小家伙，帮她带些凝胶来，也许能派上用场。",
				"ObjectiveText": "为安娜收集凝胶"
			}
		]
	},
	"DefendTownQuest": {
		"Hint": "击败龙鳞古壳后解锁。",
		"Name": "守卫天穹镇",
		"Description": "天穹镇接连发生骚乱，霍华德需要有人协助维持秩序。",
		"Objectives": [
			{
				"Description": "霍华德似乎正为镇上的骚乱发愁，去问问他吧。",
				"NPCText": "我有什么麻烦？听说你最近击败了龙鳞古壳，非常好，这证明你确实有实力。正好最近小镇上有一些闹事的混混，镇民都在抱怨，你去教育教育他们。"
			},
			{
				"Description": "醉酒矿工的游行扰乱了小镇的安宁，帮霍华德平息这场骚乱。",
				"ObjectiveText": "前往天穹镇，等待夜幕降临，击退醉酒矿工游行。"
			},
			{
				"Description": "醉酒矿工的骚乱暂时平息了，去向霍华德报告情况。",
				"NPCText": "干得不错，这帮醉酒的矿工总算消停了。不过镇上还有一群飞贼在闹事，恐怕还得请你搭把手。"
			},
			{
				"Description": "镇上的飞贼又惹出了麻烦，阻止他们继续作乱。",
				"ObjectiveText": "挡住飞贼横行"
			},
			{
				"Description": "飞贼引起的骚乱已经平息，回去问问霍华德镇上的情况。",
				"NPCText": "飞贼的事我听说了，办得漂亮。可镇上还没太平多久，那位千金和刺客又闹出了风波，还得劳烦你去看看。"
			},
			{
				"Description": "千金与刺客的风波让小镇再起骚乱，帮助霍华德恢复秩序。",
				"ObjectiveText": "挡住千金与刺客"
			},
			{
				"Description": "千金与刺客的风波暂告一段落，去向霍华德汇报。",
				"NPCText": "这场风波总算平息了。不过有人竟然想在街头举行活祭，这可不能放任不管。快去阻止他们！"
			},
			{
				"Description": "有人试图在街头举行活祭，尽快阻止这场暴行。",
				"ObjectiveText": "阻止当街活祭"
			},
			{
				"Description": "街头的活祭已经被阻止，回去告诉霍华德小镇暂时安全了。",
				"NPCText": "幸亏你及时阻止了那场活祭，镇民们才没有遭殃。辛苦了，我替天穹镇的大家谢谢你。"
			}
		]
	},
	"Rolle": "罗尔",
	"Betty": "贝蒂",
	"Schorl": "夜璃",
	"Georg": "格尔格",
	"IngredientSupplyOneQuest": {
		"Name": "食材补充 其一",
		"Description": "餐厅的生意太好，罗尔来不及补充鱼货。",
		"Hint": "进入天穹树后解锁。",
		"Objectives": [
			{
				"Description": "去餐厅问问罗尔有没有需要帮忙的事。",
				"NPCText": "啊，原来你是新来的啊。既然你都问了，那正好这两天的生意太好了，餐厅甚至来不及进货。你帮我弄些草鱼来，你的晚饭我就包了。"
			},
			{
				"Description": "给罗尔送去五条草鱼，帮餐厅补充食材。",
				"StartText": "啊，原来你是新来的啊。既然你都问了，那正好这两天的生意太好了，餐厅甚至来不及进货。你帮我弄些草鱼来，你的晚饭我就包了。",
				"EndText": "这些鱼还真是肥美。就像我之前说的，你的晚饭我包了。"
			}
		]
	},
	"SelfRelianceQuest": {
		"Name": "自力更生",
		"Description": "罗尔想教你准备一道能填饱肚子的菜。",
		"Hint": "击败球冻王或龙鳞古壳后解锁。",
		"Objectives": [
			{
				"Description": "罗尔似乎有些做菜的心得想告诉你。",
				"NPCText": "都啥时候了还来找事做呢？这样，我也不想看见你饿得挥不动剑。我看你也挺有诚意的，我来教你做一份灯果汁腌草鱼，后面你也能自己喂饱自己。"
			},
			{
				"Description": "准备十二个灯果。这一步只检查背包中的数量，不会消耗灯果。"
			},
			{
				"Description": "灯果已经备齐，回去找罗尔。",
				"NPCText": "灯果准备好了？做菜首先要学会自己备料，灯果汁腌草鱼会用得上这些。"
			}
		]
	},
	"IngredientSupplyTwoQuest": {
		"Name": "食材补充 其二",
		"Description": "罗尔听说了苍苔帘幕中的荆棘苔龟，想从它身上寻找新菜的灵感。",
		"Hint": "有人进入苍苔帘幕后解锁。",
		"Objectives": [
			{
				"Description": "回餐厅听听罗尔对新食材的想法。",
				"NPCText": "我听说你遇到了荆棘苔龟，帮我弄一只来，说不定可以研究出新菜。"
			},
			{
				"Description": "去苍苔帘幕击败一只荆棘苔龟。"
			},
			{
				"Description": "已经击败荆棘苔龟，回去向罗尔报告。",
				"NPCText": "很新鲜嘛，你眼光不错。怎么样，不是很难吧？不和你说了，新菜的灵感涌出来了。"
			}
		]
	},
	"SprainedBackQuest": {
		"Name": "伤筋动骨",
		"Description": "罗尔研究新菜时摔伤了腰，贝蒂想为他准备药。",
		"Hint": "完成「自力更生」后解锁。",
		"Objectives": [
			{
				"Description": "贝蒂似乎正在为老板的伤势发愁，去问问她。",
				"NPCText": "你别说，老板前两天捣鼓新菜的时候摔到腰了。看样子你已经和老板是老交情了，你帮我搞来万花油的原料，让我们老板好得快一点吧。"
			},
			{
				"Description": "把脱稳花粉交给贝蒂，帮助她准备万花油。"
			},
			{
				"Description": "把虫汁交给贝蒂，帮助她准备万花油。"
			},
			{
				"Description": "两种原料都已交齐，和贝蒂确认一下。",
				"NPCText": "原料都齐了，谢谢你！希望老板能早点好起来，这几天可得让他好好歇歇。"
			}
		]
	},
	"TroublesomeGuestsQuest": {
		"Name": "头疼的客人",
		"Description": "一群海盗拖欠了餐厅的账款，贝蒂希望有人出面处理。",
		"Hint": "等待贝蒂委托你处理海盗的欠账。",
		"Objectives": [
			{
				"Description": "听听贝蒂遇到了什么麻烦。",
				"NPCText": "那群海盗你知道吧？已经欠了三个月的账了，帮我收回来，有你一份。"
			},
			{
				"Description": "找到欠账的海盗，让他们结清餐费。",
				"ObjectiveText": "处理拖欠餐费的海盗"
			},
			{
				"Description": "回去告诉贝蒂欠账的事已经处理好了。",
				"NPCText": "谢谢，希望能管用。这种麻烦的客人还是少一点比较好。"
			}
		]
	},
	"TeahouseTalesOneQuest": {
		"Name": "茶馆轶事 其一",
		"Description": "夜璃对无主肉傀的传闻很感兴趣。",
		"Hint": "进入天穹树后解锁。",
		"Objectives": [
			{
				"Description": "茶馆的夜璃似乎听说了一个奇怪的传闻。",
				"NPCText": "小家伙，你是冒险者吧？我听说有一种怪物和人类极其相像，能帮姐姐打探打探无主肉傀，然后处理掉这个家伙怎么样？"
			},
			{
				"Description": "调查那个与人类极其相像的怪物，处理掉无主肉傀。",
				"ObjectiveText": "寻找并处理无主肉傀"
			},
			{
				"Description": "把无主肉傀的故事带回茶馆，讲给夜璃听。",
				"NPCText": "真是听到了不错的故事呢，小家伙真棒，奖励你摸一下姐姐的尾巴怎么样？"
			}
		]
	},
	"TeahouseTalesTwoQuest": {
		"Name": "茶馆轶事 其二",
		"Description": "怪物身上的痕迹似乎与苍苔帘幕中的某个教团有关。",
		"Hint": "有人进入苍苔帘幕后解锁。",
		"Objectives": [
			{
				"Description": "夜璃有了新的线索，去茶馆听听她的发现。",
				"NPCText": "之前的那个怪物你还有印象吧？它身上的那些痕迹想来你也注意到了。去二层打探一下，那里藏着某个教团的造物，应该会有你想要的答案。"
			},
			{
				"Description": "顺着怪物身上的痕迹，寻找教团留下的线索。",
				"ObjectiveText": "调查苍苔帘幕中的教团造物"
			},
			{
				"Description": "带着调查结果返回茶馆。",
				"NPCText": "很久没有这样的好消息了。怎么样，今晚姐姐给你庆祝庆祝？"
			}
		]
	},
	"ProstheticMaintenanceQuest": {
		"Name": "义肢保养",
		"Description": "格尔格的义肢需要保养，他正在寻找合适的材料。",
		"Hint": "携带青缎矿或青缎锭，或穿戴青缎装备，与格尔格交谈。",
		"Objectives": [
			{
				"ObjectiveText": "携带青缎矿或青缎锭，或穿戴青缎装备，与格尔格交谈"
			},
			{
				"Description": "格尔格注意到了你的青缎材料，问问他需要什么。",
				"NPCText": "小伙子，我看你好像身上有我需要的东西。你看我这义肢需要保养了，但是缺少了青缎矿。你能帮我整点过来吗？自然是有报酬的。"
			},
			{
				"Description": "寻找青缎矿，帮助格尔格保养义肢。",
				"ObjectiveText": "为格尔格准备青缎矿"
			},
			{
				"Description": "回去看看格尔格的义肢保养得怎么样。",
				"NPCText": "小伙子好样的，我就知道你能帮我这个忙。"
			}
		]
	},
	"ChangingTheInnQuest": {
		"Name": "改变旅馆 其一",
		"Description": "格尔格想用苍苔帘幕中的植物改变旅馆严肃的气氛。",
		"Hint": "有人进入苍苔帘幕后解锁。",
		"Objectives": [
			{
				"Description": "格尔格似乎有了改造旅馆的打算。",
				"NPCText": "实不相瞒，很多客人私下都说旅馆太严肃了，不好。我想改变一下气氛，需要一些植物，但是这些植物据说只有在苍苔帘幕存在。你也是热心肠，帮我弄来一些应该不出问题吧？"
			},
			{
				"Description": "为格尔格带回能装点旅馆的植物。",
				"ObjectiveText": "为旅馆寻找苍苔帘幕的植物"
			},
			{
				"Description": "植物准备好了，回去看看格尔格的布置计划。",
				"NPCText": "太谢谢你了，我会好好利用这些植物来改变这里的。"
			}
		]
	},
	"LostMinerQuest": {
		"Name": "迷失的矿工",
		"Description": "矿工赫姆被困在远离同伴的地方，他希望你把消息带回公会。",
		"Hint": "遇见矿工赫姆后解锁。",
		"Objectives": [
			{
				"ObjectiveText": "找到迷路的矿工赫姆"
			},
			{
				"ObjectiveText": "巴德尔之光：帮助公会寻找赫姆"
			}
		]
	},
	"JellyDressQuest": {
		"Name": "别出心裁-球冻水波裙",
		"Description": "裁衣匠斯卡帕想用特别的材料制作一件新衣。",
		"Hint": "拜访裁衣匠斯卡帕后解锁。",
		"Objectives": [
			{
				"ObjectiveText": "向斯卡帕打听服饰制作"
			}
		]
	},
	"SageAlbionQuest": {
		"Name": "贤者阿尔比恩",
		"Description": "公会会长阿尔比恩准备给新来的攀登者一份考验。",
		"Hint": "经公会接待员引荐后解锁。",
		"Objectives": [
			{
				"ObjectiveText": "请公会接待员引荐阿尔比恩"
			}
		]
	},
	"NamelessPersonQuest": {
		"Name": "无名之人",
		"Description": "一个神秘的身影在你面前消失了。",
		"Hint": "第一次遇见界域行者后解锁。",
		"Objectives": [
			{
				"ObjectiveText": "寻找神秘商人留下的线索"
			}
