MirrorReflectionConfig: {
	DisplayName: 镜面反射（客户端）
	Enabled: {
		Label: 启用镜面反射
		Tooltip: "关闭后跳过原版反光墙和 Advanced 演示镜墙的反射捕获与绘制，保留墙面本身。仅影响本机。反射需要高画质及彩色/白色光照模式。"
	}
	Quality: {
		Label: 反射质量
		Tooltip: "控制模糊倒影的平滑度。低档开销较小，中档兼顾画质，高档保留完整滤波效果。不会改变墙面的偏移、翻转、颜色或反射强度。"
	}
}

MirrorReflectionQuality: {
	Tooltip: 控制模糊反射的滤波精度。
	Low.Label: 低
	Medium.Label: 中
	High.Label: 高
}

