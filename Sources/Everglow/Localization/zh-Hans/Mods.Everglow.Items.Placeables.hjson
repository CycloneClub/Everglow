BlueGlassbulbBand_item: {
	DisplayName: 蓝LED灯带
	Tooltip:
		'''
		放置物为绳头
		手持此物右键点击绳头引出绳子
		把绳子牵引到另一处绳头再右键点击即可完成挂绳
		手持其他物品，右键点击挂好了的绳头取消原绳
		每个绳头可以引出无数条绳，但是只能接受1条绳
		控制灯光的电路需要通过引出绳子的绳头，接受绳子的绳头无效
		'''
}

